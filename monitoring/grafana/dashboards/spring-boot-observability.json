        "textMode": "auto"
      },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "process_uptime_seconds{job=\"spring-boot-actuator\"}", "legendFormat": "Uptime", "refId": "A" }
      ],
      "title": "Application Uptime",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
