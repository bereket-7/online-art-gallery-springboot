# Database (use POSTGRES_HOST=pgdb when running via docker compose)
POSTGRES_HOST=localhost
DB_PORT=5432
POSTGRES_DB=oag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_db_password
HOST_DB_PORT=5432

# Redis (use REDIS_HOST=redis when running via docker compose)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
HOST_REDIS_PORT=6380

# Mail
MAIL_HOST=localhost
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=

# JWT (generate a secure random 256-bit hex secret for production)
JWT_SECRET=dGVzdGp3dHNlY3JldGtleWZvcmNpMjU2Yml0bG9uZ3N0cmluZw==
JWT_EXPIRE_AFTER=720
JWT_REFRESH_EXPIRE_AFTER=10080

# OTP
OTP_SALT=change_me_otp_salt

# Chapa Payment
CHAPA_SECRET_KEY=CHASECK_TEST-your_key_here

# File Storage (docker compose mounts /var/oag/uploads in the app container)
BASE_FOLDER=./uploads

# Seed Users (used only on initial startup)
SEED_ADMIN_PASSWORD=change_me_admin
SEED_CUSTOMER_PASSWORD=change_me_customer
